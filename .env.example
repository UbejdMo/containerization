# Copy this file to .env and put real values in it:  cp .env.example .env
# .env is gitignored; this template is committed and holds no real secrets.

POSTGRES_USER=tasks
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tasks

# The connection string the app reads, pointing at the published port on this
# machine. This is the value that works when the app runs on the host
# (uvicorn main:app). Inside Docker there is no "localhost database", so the
# compose file overrides DATABASE_URL for the app container with host "db" -
# the service name - built from the three variables above.
DATABASE_URL=postgresql://tasks:change_me@localhost:5432/tasks
